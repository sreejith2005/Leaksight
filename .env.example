# ===========================
# LeakSight V1 — Environment Variables (Authoritative Reference)
# ===========================
# Copy this file to .env and fill in all values marked REQUIRED.
# NEVER commit .env to version control.
# To generate a fresh .env with random secrets: ./scripts/generate_env.sh
#
# Permissions: chmod 600 .env (owner read/write only)

# ──────────────────────────────────────────────────────────
# Application Settings
# ──────────────────────────────────────────────────────────

# REQUIRED — Environment mode. Controls debug logging, database echo, etc.
# Valid values: development | staging | production
APP_ENV=production

# REQUIRED — Secret key for JWT signing. Must be unique per deployment.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
# The application will refuse to start if this is set to the placeholder value.
SECRET_KEY=<generate: python3 -c "import secrets; print(secrets.token_hex(64))">

# REQUIRED — Comma-separated list of allowed hostnames.
# Must be set to the actual domain in production (not localhost or *).
ALLOWED_HOSTS=yourdomain.com

# ──────────────────────────────────────────────────────────
# Database (PostgreSQL 15)
# ──────────────────────────────────────────────────────────

# Hostname of the PostgreSQL service (Docker Compose service name in production)
POSTGRES_HOST=postgres

# PostgreSQL port (default: 5432)
POSTGRES_PORT=5432

# Database name
POSTGRES_DB=leaksight

# Database user
POSTGRES_USER=leaksight_user

# REQUIRED — Database password. Must be a strong random string.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Avoid special characters that may break URL encoding (&, @, /, %, =).
# The application will refuse to start if this is set to the placeholder value.
POSTGRES_PASSWORD=<generate: python3 -c "import secrets; print(secrets.token_hex(32))">

# ──────────────────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────────────────

# Redis connection URL (Docker Compose service name, database 0)
REDIS_URL=redis://redis:6379/0

# ──────────────────────────────────────────────────────────
# Celery (Background Task Queue)
# ──────────────────────────────────────────────────────────

# Celery broker URL (Redis database 0 — shared with REDIS_URL)
CELERY_BROKER_URL=redis://redis:6379/0

# Celery result backend (Redis database 1 — separate from broker)
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ──────────────────────────────────────────────────────────
# Document Storage
# ──────────────────────────────────────────────────────────

# Path where uploaded documents are stored (inside container).
# Maps to /opt/leaksight/data/documents on the host via Docker volume.
DOCUMENT_STORAGE_PATH=/app/data/documents

# Maximum upload file size in MB. Matches Nginx client_max_body_size.
MAX_UPLOAD_SIZE_MB=200

# ──────────────────────────────────────────────────────────
# SMTP (Email Notifications)
# ──────────────────────────────────────────────────────────

# SMTP server hostname. Brevo free tier: smtp-relay.brevo.com (300 emails/day)
SMTP_HOST=smtp-relay.brevo.com

# SMTP server port. 587 for STARTTLS (recommended).
SMTP_PORT=587

# REQUIRED in production — SMTP authentication username (Brevo login email)
SMTP_USER=YOUR_VALUE_HERE

# REQUIRED in production — SMTP authentication password/API key
SMTP_PASSWORD=YOUR_VALUE_HERE

# From address for outgoing notification emails
SMTP_FROM=noreply@yourdomain.com

# ──────────────────────────────────────────────────────────
# Tenant Default Settings
# ──────────────────────────────────────────────────────────

# Minimum RapidFuzz score (0.0–1.0) for auto-accepting vendor/item matches.
# Below this threshold → NEEDS_MANUAL_REVIEW. Default: 0.85.
DEFAULT_FUZZY_THRESHOLD=0.85

# Number of days to look back for near-duplicate invoice detection (Rule 2).
# Two invoices from the same vendor with the same amount within this window
# are flagged as near-duplicates. Default: 30.
DEFAULT_DUPLICATE_WINDOW_DAYS=30

# Parse confidence threshold (0.0–1.0). Documents with parse_confidence below
# this value are flagged for manual review and the run status becomes
# PARTIAL_SUCCESS. Default: 0.70.
DEFAULT_MANUAL_REVIEW_THRESHOLD=0.70

# Base currency for reporting (ISO 4217 code). All leakage amounts are
# expressed in this currency. Cross-currency invoices require FX rates.
# Default: INR.
DEFAULT_BASE_CURRENCY=INR
